{
  "name": "crm-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "客户管理 CRM 线索管控演示版",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "antd": "^5.21.6",
    "dayjs": "^1.11.13",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
